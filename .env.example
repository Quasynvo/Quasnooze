# ─────────────────────────────────────────────────────────────
# Quasnooze — configuration
#  Run `npm run setup` to generate this file interactively.
#  Everything here is optional except nothing: Quasnooze boots and
#  serves the web panel even with an empty config.
# ─────────────────────────────────────────────────────────────

# ── Who you are ──────────────────────────────────────────────
OWNER_NAME=Ranjith
OWNER_TIMEZONE=Asia/Kolkata

# ── Server ───────────────────────────────────────────────────
# 0.0.0.0 lets your phone reach Quasnooze over your home Wi-Fi.
# 0.0.0.0 = reachable from your phone on the same Wi-Fi.
# If QUASNOOZE_KEY is empty and QUASNOOZE_HOST is the default, Quasnooze binds to 127.0.0.1
# only and tells you how to open it up — a keyless assistant on the LAN is an
# open shell on the LAN.
QUASNOOZE_HOST=0.0.0.0
QUASNOOZE_PORT=7777
# Shared secret for the web panel + API. `npm run setup` generates one.
# Leave empty ONLY if you trust every device on your network.
# Required for anything but localhost. `npm run setup` generates one.
QUASNOOZE_KEY=

# ── Windows resident launcher (process flag, NOT a .env setting) ──
# QUASNOOZE_DESKTOP=1 is set by `npm run desktop` / `quasnooze desktop` on Windows.
# Only the exact process-environment value "1" enables resident mode on Windows;
# putting it in .env does NOT enable it. Leave it unset for normal web/channels.
# Resident launch binds to 127.0.0.1, forces broad auto-approval off, generates a
# process-lifetime key if QUASNOOZE_KEY is empty, and starts the microphone muted.
# See docs/GUIDE.md (Windows resident launch) and docs/DESKTOP.md for boundaries.

# ── Brain (the model that does the thinking) ─────────────────
# ollama | openai | mock      (mock = canned demo brain, no model needed)
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Interactive latency: disable hidden reasoning by default. Set true deliberately.
OLLAMA_THINK=false

# Used when LLM_PROVIDER=openai (works with OpenAI, Groq, LM Studio,
# vLLM, OpenRouter — anything OpenAI-compatible). Optional fallback
# if your local model is busy.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Which provider a turn may fall back to if the selected one fails: ollama, openai, or empty
# for none. Empty by default — failing over from a local model to a cloud endpoint sends
# this conversation to a third party, which should be your decision. Run: npm run health
LLM_FALLBACK=

# ── About you ────────────────────────────────────────────────
# Optional plain-text profile Quasnooze reads every turn (one fact per line).
# Same idea as an "about me" note: it never invents anything beyond it.
# Default: data/profile.md
QUASNOOZE_PROFILE=

# ── Where Quasnooze is allowed to work ───────────────────────────
# The agent may read/write/run commands ONLY inside these roots
# (comma separated). Defaults to your home directory if unset.
QUASNOOZE_WORKSPACE=

# ── Safety ───────────────────────────────────────────────────
# Tools that change your machine (shell, write_file) ask permission
# first, in-chat. Set to true to skip that (not recommended).
QUASNOOZE_AUTO_APPROVE=false
# Hard cap, seconds, for any shell command Quasnooze runs.
QUASNOOZE_SHELL_TIMEOUT=120

# Context window, in tokens, and how much of it to keep free for the reply.
# Quasnooze trims old messages to fit rather than letting the provider truncate —
# Ollama truncates from the front, which deletes the system prompt first.
# Raise this to whatever your model actually supports (a 7B qwen: 32768).
# Third-party tools over MCP. Semicolons separate servers.
#   QUASNOOZE_MCP="files=npx -y @modelcontextprotocol/server-filesystem /home/me"
# Every call to one of these stops for your approval unless the server is named
# in QUASNOOZE_MCP_TRUSTED. An MCP server is arbitrary code from a registry.
QUASNOOZE_MCP=
QUASNOOZE_MCP_TRUSTED=

# Your own tools, from a JSON manifest. No code, no server process:
#   QUASNOOZE_TOOLS="$HOME/.pinch/tools.json"
# Each entry names a command you already trust; the model only fills in the
# arguments you declared. Every call stops for your approval — unlike MCP, there
# is no trusted-server opt-out here, because the arguments come from the model.
# See docs/GUIDE.md and pinch-tools.example.json.
QUASNOOZE_TOOLS=

# Scheduled runs — Quasnooze can run a task on a cadence ("daily at 8am, check CI")
# with nobody watching. Those turns refuse every tool that needs approval, so
# they read, search and report but never change the machine.
# Set to 0 (or false/off/no) to stop all scheduled runs and keep reminders.
QUASNOOZE_SCHEDULED_RUNS=1

QUASNOOZE_NUM_CTX=8192
QUASNOOZE_NUM_PREDICT=2048
# Commands run with a scrubbed environment: anything named like a credential
# (TOKEN, SECRET, PASSWORD, *_KEY, ...) is removed, so a build script cannot
# read your bot token. Re-admit specific names by comma, only if a build
# genuinely needs them. Empty is the safe default.
QUASNOOZE_ENV_PASSTHROUGH=
# Extra hostnames the panel may be reached on — a reverse proxy, a tunnel,
# a Tailscale name. Wildcards work: *.trycloudflare.com
# A forged Host header (DNS rebinding) is refused; this is the exception list.
QUASNOOZE_ALLOWED_HOSTS=
# Post-reply honesty check: audits claims ("I sent it") against what actually
# ran, and shows you any mismatch. Set to "off" to disable (not advised).
QUASNOOZE_GUARD=on
# Deterministic turns ("what time is it", "remind me to call mom in 20 minutes")
# answer without a model at all. Set to "off" to route every turn through it.
QUASNOOZE_FAST_PATH=on
# Read-only commands (ls, cat, git status, grep) run without a prompt;
# anything that could change something still asks, and catastrophic
# commands are refused outright. Set to "false" to be asked about every
# command again — the classifier is a convenience, not a security boundary.
QUASNOOZE_RISK_TIERS=true
# Opt-in design workflow (/plan, /approve, /cancel): drafts a bounded, reviewable
# plan and runs it only after you approve that plan in the same session. Off by
# default, and approving a design still asks for every tool the plan uses.
QUASNOOZE_WORKFLOW=off

# ── Telegram ─────────────────────────────────────────────────
# Create a bot with @BotFather, paste the token. Your numeric id
# (message @userinfobot) goes in ALLOWED so strangers can't use it.
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_IDS=

# ── Discord ──────────────────────────────────────────────────
# discord.com/developers → New Application → Bot → Reset Token.
# Enable "Message Content Intent" in the Bot tab. Invite the bot to
# your server, then put the channel id(s) you want it to watch.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# ── Slack ────────────────────────────────────────────────────
# api.slack.com/apps → From scratch → Bot token scopes:
#   chat:write, channels:history, groups:history, im:history,
#   channels:read, users:read
# Install to workspace, then copy the xoxb- token and channel id.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=

# ── WhatsApp (optional, unofficial) ──────────────────────────
# Pairs a WhatsApp Web session via Baileys. Use a SECONDARY number:
# automating a personal account is against WhatsApp's terms and they
# can ban it. Set to true, then scan the QR code printed on boot.
WHATSAPP_ENABLED=false
WHATSAPP_ALLOWED_NUMBERS=

# ── Voice ────────────────────────────────────────────────────
# On phones, Quasnooze uses the browser's built-in speech engine (free,
# on-device on iOS/Android) — nothing to install.
# Optional: a whisper.cpp server for better transcription of audio
# files sent from chat apps. e.g. http://127.0.0.1:8080
WHISPER_URL=

# ── Where data lives ────────────────────────────────────
# Quasnooze keeps sessions, memory and reminders under this directory.
# Point it at a synced or removable volume to carry your assistant
# between machines.
QUASNOOZE_DATA=

# Optional owner-reviewed JavaScript tools. Modules execute at boot, not in a sandbox.
# Use a directory OUTSIDE QUASNOOZE_WORKSPACE; loaded by server/desktop and terminal CLI.
# Leave empty to disable. See docs/GUIDE.md: Local JavaScript tool plugins.
QUASNOOZE_TOOLS_DIR=

# OS-managed environment, not Quasnooze settings: PATH is used for command lookup;
# SystemRoot locates Windows PowerShell. Leave these inherited from the OS.
# The native companion forwards only inherited SystemRoot, WINDIR, TEMP, TMP,
# USERPROFILE, APPDATA and LOCALAPPDATA; never add credentials to that allowlist.

# Legacy compatibility: existing PINCH_* configuration remains accepted.
# PINCH_ALLOWED_HOSTS is the legacy alias of QUASNOOZE_ALLOWED_HOSTS.
# PINCH_AUTO_APPROVE is the legacy alias of QUASNOOZE_AUTO_APPROVE.
# PINCH_DATA is the legacy alias of QUASNOOZE_DATA.
# PINCH_DESKTOP is the legacy alias of QUASNOOZE_DESKTOP.
# PINCH_ENV_PASSTHROUGH is the legacy alias of QUASNOOZE_ENV_PASSTHROUGH.
# PINCH_FAST_PATH is the legacy alias of QUASNOOZE_FAST_PATH.
# PINCH_GUARD is the legacy alias of QUASNOOZE_GUARD.
# PINCH_HOST is the legacy alias of QUASNOOZE_HOST.
# PINCH_KEY is the legacy alias of QUASNOOZE_KEY.
# PINCH_MCP is the legacy alias of QUASNOOZE_MCP.
# PINCH_MCP_TRUSTED is the legacy alias of QUASNOOZE_MCP_TRUSTED.
# PINCH_NUM_CTX is the legacy alias of QUASNOOZE_NUM_CTX.
# PINCH_NUM_PREDICT is the legacy alias of QUASNOOZE_NUM_PREDICT.
# PINCH_PORT is the legacy alias of QUASNOOZE_PORT.
# PINCH_PROFILE is the legacy alias of QUASNOOZE_PROFILE.
# PINCH_RISK_TIERS is the legacy alias of QUASNOOZE_RISK_TIERS.
# PINCH_SCHEDULED_RUNS is the legacy alias of QUASNOOZE_SCHEDULED_RUNS.
# PINCH_SHELL_TIMEOUT is the legacy alias of QUASNOOZE_SHELL_TIMEOUT.
# PINCH_TOOLS is the legacy alias of QUASNOOZE_TOOLS.
# PINCH_TOOLS_DIR is the legacy alias of QUASNOOZE_TOOLS_DIR.
# PINCH_WORKFLOW is the legacy alias of QUASNOOZE_WORKFLOW.
# PINCH_WORKSPACE is the legacy alias of QUASNOOZE_WORKSPACE.

# Durable packaged state: Linux XDG_STATE_HOME (absolute only), Windows LOCALAPPDATA,
# or macOS ~/Library/Application Support, under quasnooze/. Checkouts retain .env/data.
# Process-only override QUASNOOZE_STATE_HOME (legacy PINCH_STATE_HOME): absolute path.
# Set this BEFORE setup/runtime; do not put it inside .env.
