{
  "name": "@quasynvo/quasnooze",
  "version": "1.0.0",
  "description": "Quasnooze by Quasynvo \u2014 a local-first personal AI assistant with a Fluid Motion Voice Engine, everyday tools and visible permissions.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "quasnooze": "./bin/quasnooze.js",
    "pinch": "./bin/pinch.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/setup.js --check",
    "health": "node scripts/doctor.js",
    "test": "node --test",
    "demo": "node scripts/demo.js",
    "pair": "node scripts/pair.js",
    "brain": "node scripts/braincheck.js",
    "service": "node scripts/service.js",
    "supervise": "node scripts/supervise.js",
    "audit": "node scripts/audit.js",
    "radar": "node scripts/tech-radar.js",
    "growth": "node scripts/growth.js",
    "verify": "node --test && node scripts/audit.js",
    "desktop": "node scripts/desktop.js",
    "desktop:doctor": "node scripts/desktop-doctor.js"
  },
  "optionalDependencies": {
    "@whiskeysockets/baileys": "^6.7.16",
    "qrcode-terminal": "^0.12.0"
  },
  "keywords": [
    "ai-assistant",
    "local-first",
    "ollama",
    "telegram",
    "discord",
    "slack",
    "whatsapp",
    "mcp"
  ],
  "license": "MIT",
  "files": [
    "bin/",
    "src/",
    "public/",
    "scripts/setup.js",
    "scripts/migrate-state.js",
    "scripts/braincheck.js",
    "scripts/pair.js",
    "scripts/service.js",
    "scripts/supervise.js",
    "scripts/audit.js",
    "scripts/tech-radar.js",
    "scripts/growth.js",
    "scripts/roadmap-queue.js",
    "scripts/demo.js",
    "scripts/desktop.js",
    "scripts/desktop-doctor.js",
    "scripts/doctor.js",
    "desktop/windows.ps1",
    "desktop/Companion.cs",
    "desktop/SpeechDoctor.cs",
    "desktop/startup.ps1",
    "LICENSE",
    "README.md",
    "!**/.env",
    "!**/.env.*",
    "!**/data/**",
    "!**/test/**",
    "!**/.github/**",
    "!**/*.log",
    "!**/*.tgz"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quasynvo/Quasnooze.git"
  },
  "bugs": {
    "url": "https://github.com/Quasynvo/Quasnooze/issues"
  },
  "homepage": "https://github.com/Quasynvo/Quasnooze#readme",
  "quasnooze": {
    "node": {
      "min": 22,
      "dropMinAt": "2027-04-30",
      "becomes": 24,
      "reason": "Node 22 reaches end of life; engines.node moves to >=24 and 22 leaves the CI matrix."
    }
  }
}
